# Copy to .env.local for `bun run dev`, or pass with `docker run --env-file`.
# Every data source is free and keyless. Only the AI parts need a key.

# Writes the traveler briefing and answers the chat, from the assessment only.
# Never sets the risk level. Server-side only: it never reaches the browser.
# Without it, the assessment still works and the chat says it is unavailable.
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-5-mini

# api.weather.gov asks for a contact in the User-Agent.
# NWS_USER_AGENT=travel-risk (you@example.com)
