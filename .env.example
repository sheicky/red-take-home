# All optional. With nothing set, the app runs fully: every data source is free and keyless,
# and the briefing falls back to a deterministic template.

# Writes the Ops briefing from the rules' output (never sets the risk level). Server-side only.
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-5-mini

# Live same-day flight status. Free tier ~100 requests/month: https://aviationstack.com/signup/free
AVIATIONSTACK_KEY=
# The free plan has historically been HTTP-only; set this if HTTPS is refused.
# AVIATIONSTACK_BASE=http://api.aviationstack.com

# api.weather.gov asks for a contact in the User-Agent.
# NWS_USER_AGENT=travel-risk-prototype (you@example.com)
